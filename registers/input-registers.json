          "reg": 1086,
          "field": "echoLengthTime",
          "type": "U16",
          "unit": "us",
          "desc": "Waveform window length"
        },
        {
          "reg": 1104,
          "field": "gasIndex",
          "type": "U16",
          "since": "SW 4.x",
          "desc": "Entrained-gas index, 0-100. 0 = no gas detected. Instantaneous value - a single bubble crossing the beam can spike it. Derived from frame-to-frame variance, not from absolute echo amplitude, which is what lets it separate 'more bubbles' from 'more solids'."
        },
        {
          "reg": 1113,
          "field": "gasIndexEma",
          "type": "U16",
          "since": "SW 4.x",
          "desc": "Time-smoothed entrained-gas index. This is the one to alarm on: it ignores isolated bubbles and responds to sustained gas. The instrument's own bubble flag is driven by this value exceeding its threshold for consecutive cycles."
        }
      ]
    },
    {
      "name": "History",
      "start": 7990,
      "registers": [
        {
          "reg": 7990,
          "field": "historyCapacity",
          "type": "U16",
          "desc": "Number of history records the instrument can hold. Self-describing: read this before walking the history area. Firmware without this register answers exception 02."
        }
      ]
    }
  ]
}