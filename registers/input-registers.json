          "reg": 1080,
          "field": "inputMin",
          "type": "U16",
          "unit": "mV",
          "desc": "Input range minimum"
        },
        {
          "reg": 1081,
          "field": "inputMax",
          "type": "U16",
          "unit": "mV",
          "desc": "Input range maximum"
        },
        {
          "reg": 1082,
          "field": "outputMin",
          "type": "U16",
          "unit": "mV",
          "desc": "Output range minimum"
        },
        {
          "reg": 1083,
          "field": "outputMax",
          "type": "U16",
          "unit": "mV",
          "desc": "Output range maximum"
        },
        {
          "reg": 1084,
          "field": "sampleFrequency",
          "type": "U16",
          "unit": "kHz",
          "desc": "Waveform sampling frequency"
        },
        {
          "reg": 1085,
          "field": "echoOffsetTime",
          "type": "U16",
          "unit": "us",
